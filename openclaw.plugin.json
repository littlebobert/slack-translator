{
  "id": "slack-translation-relay",
  "name": "Slack Translation Relay",
  "description": "Forwards Slack DMs and mentions through iMessage while you are away, translating Japanese messages without replying in Slack.",
  "uiHints": {
    "slackUserId": {
      "label": "Your Slack user ID",
      "placeholder": "U0123456789"
    },
    "slackUserTokenEnv": {
      "label": "Slack user token environment variable"
    },
    "imessageRecipient": {
      "label": "iMessage recipient",
      "placeholder": "+15555550123 or user@example.com"
    },
    "imsgCliPath": {
      "label": "imsg CLI path"
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["slackUserId", "imessageRecipient"],
    "properties": {
      "slackUserId": {
        "type": "string",
        "pattern": "^U[A-Z0-9]+$"
      },
      "slackUserTokenEnv": {
        "type": "string",
        "default": "SLACK_USER_TOKEN"
      },
      "imessageRecipient": {
        "type": "string",
        "minLength": 3
      },
      "imsgCliPath": {
        "type": "string",
        "default": "/opt/homebrew/opt/imsg/bin/imsg"
      },
      "notificationTitle": {
        "type": "string",
        "maxLength": 250,
        "default": "Slack while away"
      },
      "maxConcurrency": {
        "type": "integer",
        "minimum": 1,
        "maximum": 8,
        "default": 2
      },
      "dedupeTtlSeconds": {
        "type": "integer",
        "minimum": 60,
        "maximum": 86400,
        "default": 3600
      },
      "presenceCacheSeconds": {
        "type": "integer",
        "minimum": 5,
        "maximum": 300,
        "default": 30
      },
      "requestTimeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 60000,
        "default": 10000
      }
    }
  }
}
